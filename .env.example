# ─────────────────────────────────────────────
#  Google Sheets Configuration
#  Buat Service Account → https://console.cloud.google.com
#  Tambahkan service account email sebagai Editor di Spreadsheet
# ─────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ID Spreadsheet dari URL: /spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Nama tab sheet (akan dibuat otomatis jika belum ada)
GOOGLE_SHEET_NAME=Transaksi

# ─────────────────────────────────────────────
#  WhatsApp (Baileys)
#  Format nomor: 628xxxxxxxxxx (tanpa + atau spasi)
# ─────────────────────────────────────────────
WA_TARGET_NUMBER=628123456789

# Folder penyimpanan session Baileys (dipakai kalau Upstash tidak dikonfigurasi)
WA_SESSION_DIR=./wa-session

# ─────────────────────────────────────────────
#  Upstash Redis (opsional tapi direkomendasikan untuk Railway/production)
#  Buat database gratis di https://console.upstash.com
#  Kalau diisi, session WA tersimpan permanen di Redis (tidak hilang saat restart)
#  Kalau kosong, fallback ke file system (WA_SESSION_DIR)
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
